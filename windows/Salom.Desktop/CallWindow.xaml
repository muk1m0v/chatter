<Window x:Class="Salom.Desktop.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Звонок · Салом" Width="440" Height="660" MinWidth="360" MinHeight="520"
        Background="#11161D" Foreground="#EDF1F5" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <wv2:WebView2 x:Name="CallBrowser" Grid.Row="0"/>
        <TextBlock x:Name="CallStatus" Grid.Row="1" Text="Подключаю звонок…" Foreground="#FFC400" Margin="8,10" TextAlignment="Center"/>
    </Grid>
</Window>
