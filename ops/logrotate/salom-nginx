/var/log/nginx/salom-access.log /var/log/nginx/salom-error.log {
    daily
    rotate 7
    maxsize 10M
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www-data adm
    sharedscripts
    postrotate
        systemctl kill -s USR1 --kill-who=main nginx.service 2>/dev/null || true
    endscript
}
